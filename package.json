{
  "name": "chronos-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop game launcher built around a shelf of cartridges.",
  "author": "Chronos Contributors",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.chronos.launcher",
    "productName": "Chronos",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "benitocarranco493-rgb",
        "repo": "Chronos"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Chronos-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Chronos-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Chronos-${version}-${arch}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "Chronos-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.5.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
